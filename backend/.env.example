# LOCAL reads and indexes the downloaded NASA CSV datasets under ..\Data.
# LOCAL_PARTIAL serves the committed SQLite rows without resuming indexing.
AGNIWATCH_DATA_MODE=LOCAL_PARTIAL
AGNIWATCH_DATA_ROOT=..\Data
AGNIWATCH_CORS_ORIGINS=https://your-frontend-domain.vercel.app
# Legacy compatibility setting; LOCAL API queries use the complete disk index.
AGNIWATCH_LOCAL_MAX_RECORDS=50000
# Set REAL only after adding a valid NASA FIRMS map key.
FIRMS_MAP_KEY=replace-with-your-firms-map-key
